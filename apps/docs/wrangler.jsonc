{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bloggerkit-docs",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "blogger.fineshop.app",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}
