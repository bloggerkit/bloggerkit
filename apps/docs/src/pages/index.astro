---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Bot from '@lucide/astro/icons/bot';
import GitBranch from '@lucide/astro/icons/git-branch';
import LayoutGrid from '@lucide/astro/icons/layout-grid';
import Search from '@lucide/astro/icons/search';
import Backdrop from '@/components/home/Backdrop.astro';
import HeroIllustration from '@/components/home/HeroIllustration.astro';
import SectionOverview from '@/components/sections/SectionOverview.astro';
import SectionTile from '@/components/sections/SectionTile.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { countCodeBlocks } from '@/lib/content/markdown';
import { getPages } from '@/lib/content/pages';
import { getSections, getTopics, walk } from '@/lib/content/sections';
import { docsRoute, resources } from '@/lib/routes';
import { appDescription, appName, githubUrl } from '@/lib/site';
import { buttonBase, buttonPrimary, buttonSecondary } from '@/lib/ui/buttons';

const sections = getSections();
// Pages in a section sidebar, for the stats
const slugs = sections.flatMap((section) => [...walk(section.folder)]);
const pagesBySlug = await getPages();
const examples = slugs.reduce(
	(total, slug) => total + countCodeBlocks(pagesBySlug.get(slug)?.body ?? ''),
	0,
);
const topics = sections.flatMap((section) => getTopics(section));
const stats = [
	{ value: slugs.length, label: 'pages' },
	{ value: examples, label: 'code examples' },
	{
		value: sections.length,
		label: sections.length === 1 ? 'section' : 'sections',
	},
	{ value: topics.length, label: 'topics' },
];
---

<BaseLayout title={appName} description={appDescription}>
	<main id="content">
		<section class="relative overflow-hidden border-b border-border">
			<Backdrop variant="hero" />

			{/* Single column on phones; the illustration's code scrolls instead of widening the page */}
			<div class="relative mx-auto grid max-w-300 grid-cols-1 items-center gap-10 px-4 pt-12 pb-14 sm:gap-14 sm:py-20 lg:grid-cols-2 lg:py-24 md:px-6 xl:grid-cols-[minmax(0,1fr)_35rem]">
				<div class="flex flex-col items-start">
					{/* Softer corners when the pill wraps; the dot stays centered */}
					<span
						class="mb-6 inline-flex items-center gap-2 rounded-2xl border border-border bg-card px-3 py-1.5 text-meta leading-4.5 text-muted-foreground"
					>
						<span class="relative flex size-2 shrink-0">
							<span class="beacon absolute inline-flex size-full rounded-full bg-success opacity-60"></span>
							<span class="relative inline-flex size-2 rounded-full bg-success"></span>
						</span>
						{/* Shorter text on the narrowest phones so the pill fits on one line */}
						<span class="max-[340px]:hidden">{slugs.length} pages of guides and references</span>
						<span class="min-[340px]:hidden">{slugs.length} pages of docs</span>
					</span>
					<h1 class="m-0 text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-[3.4rem]">
						Build on Blogger, <span class="text-muted-foreground">from themes to tools.</span>
					</h1>
					<p class="mt-4 mb-0 max-w-140 text-base text-pretty text-muted-foreground sm:mt-5 sm:text-lg">
						{appName} documents everything for building on Blogger: the theme language Google never specified, the
						tools around it and the {appName} packages, with examples that work in Blogger as they are.
					</p>
					{/* Two equal-width buttons on phones, stacked below 380px where labels would wrap */}
					<div class="mt-7 grid w-full grid-cols-1 gap-3 min-[380px]:grid-cols-2 sm:mt-8 sm:flex sm:w-auto">
						<a href={docsRoute} class:list={[buttonBase, buttonPrimary]}>
							Browse the docs
							<ArrowRight size={16} aria-hidden="true" />
						</a>
						<button
							type="button"
							class:list={[buttonBase, buttonSecondary, 'cursor-pointer bg-card']}
							data-open-search
						>
							<Search size={16} aria-hidden="true" />
							<span class="sm:hidden">Search</span>
							<span class="max-sm:hidden">Search the docs</span>
							<kbd class="ms-1 rounded border border-border px-1.5 font-sans text-xs text-muted-foreground max-sm:hidden">/</kbd>
						</button>
					</div>
				</div>
				<HeroIllustration />
			</div>
		</section>

		<section class="border-b border-border bg-card/40">
			{/* `<dt>` must come first in a `<dl>`; flex-col-reverse shows the label under its number */}
			<dl class="mx-auto m-0 grid max-w-300 grid-cols-2 gap-px px-4 sm:grid-cols-4 md:px-6">
				{
					stats.map((stat) => (
						<div class="flex flex-col-reverse gap-1 px-2 py-8 text-center">
							<dt class="text-sm text-muted-foreground">{stat.label}</dt>
							<dd class="m-0 text-3xl font-semibold tracking-tight tabular-nums">{stat.value.toLocaleString('en')}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section class="mx-auto max-w-300 px-4 py-16 sm:py-20 md:px-6">
			<div class="mb-8 flex flex-col gap-2">
				<h2 class="m-0 text-2xl font-semibold tracking-tight">Sections</h2>
				<p class="m-0 text-muted-foreground">
					Each part of {appName} has its own section, with its own pages, sidebar and search topics.
				</p>
			</div>
			{/* A few sections show in full, with their topics. Past that, compact cards, and `/docs` has the topics */}
			{
				sections.length <= 2 ? (
					<div class="flex flex-col gap-4">
						{sections.map((section) => (
							<SectionOverview section={section} />
						))}
					</div>
				) : (
					<>
						<ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
							{sections.map((section) => (
								<li class="m-0 flex">
									<SectionTile section={section} />
								</li>
							))}
						</ul>
						<a
							href={docsRoute}
							class="group mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-foreground no-underline hover:underline hover:underline-offset-4"
						>
							Browse all sections and topics
							<ArrowRight size={15} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
						</a>
					</>
				)
			}
		</section>

		<section class="mx-auto max-w-300 px-4 pb-24 md:px-6">
			<div class="relative overflow-hidden rounded-3xl border border-border bg-card px-6 py-14 text-center sm:px-12">
				<div
					class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle_at_50%_0%,color-mix(in_srgb,var(--primary)_10%,transparent),transparent_60%)]"
					aria-hidden="true"
				>
				</div>
				<h2 class="relative m-0 text-3xl font-semibold tracking-tight text-balance">Where to start</h2>
				<p class="relative mx-auto mt-3 mb-0 max-w-140 text-muted-foreground">
					Every section opens with an introduction that says what it covers and how its pages are organized. Pick
					one, or search all of them at once.
				</p>
				<div class="relative mt-8 flex flex-wrap justify-center gap-3">
					{/* A button per section while there are few. Past that, the first section and a link to all of them */}
					{
						sections.length <= 2 ? (
							sections.map((section, i) => (
								<a
									href={section.url}
									class:list={[buttonBase, i === 0 ? buttonPrimary : [buttonSecondary, 'bg-background']]}
								>
									{section.name}
									<ArrowRight size={16} aria-hidden="true" />
								</a>
							))
						) : (
							<>
								<a href={sections[0].url} class:list={[buttonBase, buttonPrimary]}>
									Start with {sections[0].name}
									<ArrowRight size={16} aria-hidden="true" />
								</a>
								<a href={docsRoute} class:list={[buttonBase, buttonSecondary, 'bg-background']}>
									<LayoutGrid size={16} aria-hidden="true" />
									Browse all sections
								</a>
							</>
						)
					}
					<button
						type="button"
						class:list={[buttonBase, buttonSecondary, 'cursor-pointer bg-background']}
						data-open-search
					>
						<Search size={16} aria-hidden="true" />
						Search the docs
					</button>
				</div>
			</div>

			<div class="mt-4 grid gap-4 md:grid-cols-2">
				<div class="flex flex-col gap-2 rounded-2xl border border-border p-6">
					<span class="flex items-center gap-2 font-medium"><Bot size={18} aria-hidden="true" /> For AI tools</span>
					<p class="m-0 text-sm text-muted-foreground">
						Every page is also plain Markdown. <a href={resources.llms} class="text-foreground underline">llms.txt</a> lists
						them, <a href={resources.llmsFull} class="text-foreground underline">llms-full.txt</a> has them all in one file.
					</p>
				</div>
				<div class="flex flex-col gap-2 rounded-2xl border border-border p-6">
					<span class="flex items-center gap-2 font-medium"><GitBranch size={18} aria-hidden="true" /> Open source</span>
					<p class="m-0 text-sm text-muted-foreground">
						The source of the packages and of these docs is on{' '}
						<a href={githubUrl} class="text-foreground underline" target="_blank" rel="noreferrer noopener">GitHub</a>.
						Every page links to its file.
					</p>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.beacon {
		animation: beacon 2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}
	@keyframes beacon {
		75%,
		100% {
			transform: scale(2.2);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.beacon {
			animation: none;
		}
	}
</style>
