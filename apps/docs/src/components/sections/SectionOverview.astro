---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import IconTile from '@/components/ui/IconTile.astro';
import LucideIcon from '@/components/ui/LucideIcon.astro';
import { countPages, getTopics, type Section } from '@/lib/content/sections';
import { plural } from '@/lib/format';
import { getPageUrl } from '@/lib/routes';

interface Props {
	section: Section;
	/** `3` on the home page, under its "Sections" heading; `2` on `/docs`, right under the page title. */
	headingLevel?: 2 | 3;
}

/** A section with its name, description, a "Start reading" link and its topics. On the home page and `/docs`. */
const { section, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const topics = getTopics(section).map((folder) => ({
	folder,
	count: countPages(folder),
}));
const pages = countPages(section.folder);
---

{/* Items reset `.markdown` list margins (on /docs), so rows keep the gap */}
<article class="rounded-2xl border border-border bg-card/50 p-4 sm:p-6">
	<header class="flex items-start gap-3 sm:gap-4">
		{section.icon && <IconTile name={section.icon} variant="overview" />}
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			<div class="flex items-start justify-between gap-4">
				<Heading class="m-0 text-lg leading-snug font-semibold max-sm:mt-1">{section.name}</Heading>
				<a
					href={section.url}
					class="inline-flex h-9 shrink-0 items-center gap-2 rounded-lg border border-border bg-background px-3 text-sm font-medium text-foreground no-underline transition-colors hover:bg-accent max-sm:hidden"
				>
					Start reading<span class="sr-only">: {section.name}</span>
					<ArrowRight size={15} aria-hidden="true" />
				</a>
			</div>
			{section.description && <p class="m-0 text-sm text-muted-foreground max-sm:hidden">{section.description}</p>}
			<p class="m-0 text-meta text-muted-foreground">
				{plural(pages, 'page')} · {plural(topics.length, 'topic')}
			</p>
		</div>
	</header>
	{section.description && <p class="mt-3 mb-0 text-sm text-muted-foreground sm:hidden">{section.description}</p>}
	{
		topics.length > 0 && (
			<ul class="m-0 mt-4 grid list-none grid-cols-1 p-0 max-md:divide-y max-md:divide-border max-md:overflow-hidden max-md:rounded-xl max-md:border max-md:border-border max-md:bg-background md:mt-5 md:grid-cols-3 md:gap-2">
				{topics.map(({ folder, count }) => (
					<li class="m-0 flex min-w-0">
						<a
							href={getPageUrl(folder.slug)}
							class="group flex w-full items-center gap-3 px-3.5 py-3 no-underline transition-colors hover:bg-accent md:items-start md:rounded-xl md:border md:border-border md:bg-background md:p-3"
						>
							{folder.icon && (
								<span class="flex shrink-0 text-muted-foreground transition-colors group-hover:text-foreground md:mt-0.5">
									<LucideIcon name={folder.icon} size={16} />
								</span>
							)}
							<span class="flex min-w-0 flex-1 flex-col gap-0.5">
								<span class="flex min-w-0 items-baseline gap-2 text-summary font-medium text-foreground md:text-sm">
									<span class="truncate md:whitespace-normal">{folder.name}</span>
									{/* Only the number shows. Screen readers hear "12 pages" */}
									<span class="shrink-0 text-meta font-normal text-muted-foreground">
										{count}<span class="sr-only">{count === 1 ? ' page' : ' pages'}</span>
									</span>
								</span>
								{folder.description && (
									<span class="line-clamp-2 text-meta leading-relaxed text-muted-foreground max-md:hidden">{folder.description}</span>
								)}
							</span>
							<ChevronRight size={16} class="shrink-0 text-muted-foreground md:hidden" aria-hidden="true" />
						</a>
					</li>
				))}
			</ul>
		)
	}
	<a
		href={section.url}
		class="mt-4 flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-primary text-sm font-medium text-primary-foreground no-underline transition-opacity hover:opacity-90 sm:hidden"
	>
		Start reading<span class="sr-only">: {section.name}</span>
		<ArrowRight size={15} aria-hidden="true" />
	</a>
</article>
