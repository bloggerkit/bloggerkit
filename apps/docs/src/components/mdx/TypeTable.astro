---
interface Property {
	type: string;
	description?: string;
	default?: string;
	required?: boolean;
}

interface Props {
	type: Record<string, Property>;
}

/** A props/options table: `<TypeTable type={{ name: { type: 'string', required: true } }} />`. */
const properties = Object.entries(Astro.props.type);
---

{/* No scroll wrapper: `.markdown` tables scroll on their own */}
<table>
	<thead>
		<tr>
			<th>Prop</th>
			<th>Type</th>
			<th>Default</th>
		</tr>
	</thead>
	<tbody>
		{
			properties.map(([name, property]) => (
				<tr>
					<td>
						{/* Name and `?` in one string, so no space or line break between them */}
						<code class="font-medium text-primary">{`${name}${property.required === true ? '' : '?'}`}</code>
					</td>
					<td>
						<code>{property.type}</code>
						{property.description && (
							<p class="mt-1 mb-0 text-sm text-muted-foreground">{property.description}</p>
						)}
					</td>
					<td>{property.default ? <code>{property.default}</code> : '-'}</td>
				</tr>
			))
		}
	</tbody>
</table>
