{/* Numbered `<Step>`s beside a line. The offset lines up each number's circle (inside its 4px ring) with the text's edge */}
<ol
	class="my-0 ms-[calc(var(--step-size)/2-4px)] list-none border-s border-border ps-(--step-gap) [--step-gap:1rem] [--step-size:2rem] [counter-reset:step] sm:[--step-gap:1.25rem]"
>
	<slot />
</ol>
