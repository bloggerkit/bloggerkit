---
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/lib/site';
---

{/* Print only, above the content on the first page: the site's logo and address */}
<div class="mb-8 hidden items-center justify-between border-b border-border pb-3 print:flex" aria-hidden="true">
	<Logo />
	<span class="text-sm text-muted-foreground">{site.host}</span>
</div>
