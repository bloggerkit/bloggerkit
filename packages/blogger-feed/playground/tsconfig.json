{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [".", "../src"]
}
