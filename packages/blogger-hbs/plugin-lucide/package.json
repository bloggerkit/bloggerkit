{
  "name": "@blogger-hbs/plugin-lucide",
  "version": "0.0.0",
  "description": "Lucide icons for blogger-hbs themes.",
  "keywords": [
    "blogger",
    "blogger-theme",
    "blogger-hbs",
    "blogger-hbs-plugin",
    "lucide"
  ],
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "email": "deo@fineshopdesign.com",
    "url": "https://github.com/kumardeo"
  },
  "homepage": "https://github.com/bloggerkit/bloggerkit/tree/main/packages/blogger-hbs/plugin-lucide#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloggerkit/bloggerkit",
    "directory": "packages/blogger-hbs/plugin-lucide"
  },
  "bugs": {
    "url": "https://github.com/bloggerkit/bloggerkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@lucide/icons": "^1.56.0"
  },
  "peerDependencies": {
    "blogger-hbs": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "blogger-hbs": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
