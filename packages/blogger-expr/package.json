{
  "name": "blogger-expr",
  "version": "0.0.0",
  "private": true,
  "description": "Parser and evaluator for Blogger theme XML expressions.",
  "keywords": [
    "blogger-theme"
  ],
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "email": "deo@fineshopdesign.com",
    "url": "https://github.com/kumardeo"
  },
  "homepage": "https://github.com/bloggerkit/bloggerkit/tree/main/packages/blogger-expr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloggerkit/bloggerkit",
    "directory": "packages/blogger-expr"
  },
  "bugs": {
    "url": "https://github.com/bloggerkit/bloggerkit/issues"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
